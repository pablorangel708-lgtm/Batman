-- AÇÕES: mira, giro do corpo, puxão do gancho
------------------------------------------------------------------------
local function aimInfo(range)
	local cam = Workspace.CurrentCamera
	local vs = cam.ViewportSize
	local ray = cam:ViewportPointToRay(vs.X / 2, vs.Y / 2)
	local dir = ray.Direction
	local res = Workspace:Raycast(ray.Origin, dir * (range + 25), rayParams())
	local endPoint = res and res.Position or (ray.Origin + dir * range)
	return res, dir, endPoint
end

local function turnToward(token, dir, dur)
	local hrp = Rig.hrp
	local flat = Vector3.new(dir.X, 0, dir.Z)
	if not hrp or flat.Magnitude < 0.01 then return true end
	local startRot = hrp.CFrame.Rotation
	local targetRot = CFrame.lookAt(Vector3.zero, flat).Rotation
	local t0 = os.clock()
	while token == Anim.token do
		local a = math.min((os.clock() - t0) / dur, 1)
		hrp.CFrame = CFrame.new(hrp.Position) * startRot:Lerp(targetRot, a)
		if a >= 1 then break end
		RunService.Heartbeat:Wait()
	end
	return token == Anim.token
end

local function pullPlayer(token, target)
	local hrp, hum = Rig.hrp, Rig.hum
	local att = create("Attachment", { Name = "BTS_PullAtt" }, hrp)
	local lv = create("LinearVelocity", {
		Name = "BTS_Pull", Attachment0 = att, RelativeTo = Enum.ActuatorRelativeTo.World,
		MaxForce = 1e7, VectorVelocity = Vector3.zero,
	}, hrp)
	local oldAuto = hum.AutoRotate
	hum.AutoRotate = false
	local done = false
	local function cleanup()
		if done then return end
		done = true
		pcall(function() lv:Destroy() end)
		pcall(function() att:Destroy() end)
		pcall(function() hum.AutoRotate = oldAuto end)
	end
	Anim.addCleanup(cleanup)
	hum:ChangeState(Enum.HumanoidStateType.Freefall)

	local t0 = os.clock()
	local lastPos, lastCheck = hrp.Position, t0
	local arrived = false
	local lastDir = Vector3.new(0, 0, -1)
	while token == Anim.token and hum.Health > 0 do
		RunService.Heartbeat:Wait()
		local pos = hrp.Position
		local to = target - pos
		local dist = to.Magnitude
		if dist < 7 then arrived = true break end
		local el = os.clock() - t0
		if el > 3.5 then break end
		lastDir = to.Unit
		lv.VectorVelocity = lastDir * math.min(CONFIG.HookPullSpeed, 28 + el * 220)
		local flat = Vector3.new(to.X, 0, to.Z)
		if flat.Magnitude > 0.5 then hrp.CFrame = CFrame.lookAt(pos, pos + flat) end
		if os.clock() - lastCheck > 0.5 then
			if (pos - lastPos).Magnitude < 3 then break end
			lastPos, lastCheck = pos, os.clock()
		end
	end
	cleanup()
	if arrived and token == Anim.token and hum.Health > 0 then
		-- impulso final (sobe a borda como no jogo)
		hrp.AssemblyLinearVelocity = lastDir * 38 + Vector3.new(0, 36, 0)
	end
	return arrived
end

