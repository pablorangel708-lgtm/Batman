UserInputService.JumpRequest:Connect(function()
	if not Rig.alive or not Rig.hum then return end
	if State.glide then
		-- pular durante o planeio solta a capa
		if os.clock() - (State.glideStart or 0) > 0.5 then Glide.stop() end
		return
	end
	if CONFIG.GlideOnDoubleJump and State.cape and Rig.hum.FloorMaterial == Enum.Material.Air and os.clock() - State.airStart > 0.2 then
		Glide.start()
	end
end)

