local function uiBaseScale()
	local vs = (Workspace.CurrentCamera and Workspace.CurrentCamera.ViewportSize) or Vector2.new(800, 400)
	return clamp(math.min(vs.X / 800, vs.Y / 400), 0.72, 1.15)
