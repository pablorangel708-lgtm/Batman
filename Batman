local function buildAssembly(name, defs)
	local model = Instance.new("Model")
	model.Name = name
	local handle
	for i, d in ipairs(defs) do
		local p = newPart({ Name = d.n or ("BTS_Part" .. i), Size = d.s, Color = d.c or C.DARK, Material = d.m or Enum.Material.SmoothPlastic }, d.class)
		if d.neon then p.Material = Enum.Material.Neon end
		if i == 1 then
			handle = p
		else
			local w = Instance.new("Weld")
			w.Part0 = handle
			w.Part1 = p
			w.C0 = d.o
			w.Parent = p
		end
		p.Parent = model
	end
	model.PrimaryPart = handle
	return model, handle
end

