local Glide = { conn = nil, lv = nil, att = nil, old = nil, params = nil }

function Glide.stop(silent)
	if not State.glide then return end
	State.glide = false
	if Glide.conn then Glide.conn:Disconnect() Glide.conn = nil end
	pcall(function()
		if Glide.lv then Glide.lv:Destroy() end
		if Glide.att then Glide.att:Destroy() end
	end)
	Glide.lv, Glide.att = nil, nil
	local hum = Rig.hum
	if hum and hum.Parent and Glide.old then
		hum.AutoRotate = Glide.old.auto
		hum.PlatformStand = Glide.old.ps
		if hum.Health > 0 then hum:ChangeState(Enum.HumanoidStateType.Freefall) end
	end
	Glide.old = nil
	if Rig.alive and not silent then
		Anim.begin()
		Anim.pose({}, 0.3)
		if Cape.open then tw(Cape.open, 0.45, { Value = 0 }) end
	elseif Cape.open then
		Cape.open.Value = 0
	end
	refreshUI()
end

function Glide.step(dt, st)
	local hrp, hum = Rig.hrp, Rig.hum
	if not Rig.alive or not hrp or not hum or hum.Health <= 0 or not Glide.lv then
		Glide.stop(true)
		return
	end
	local cam = Workspace.CurrentCamera
	local cl = cam.CFrame.LookVector
	local h = st.heading
	local before = h

	-- direção: segue a câmera (arrastar a tela) + direcional do joystick
	local camFlat = Vector3.new(cl.X, 0, cl.Z)
	if camFlat.Magnitude > 0.05 then
		camFlat = camFlat.Unit
		local ang = math.atan2(h:Cross(camFlat).Y, h:Dot(camFlat))
		local maxStep = 1.5 * dt
		h = CFrame.Angles(0, clamp(ang, -maxStep, maxStep), 0):VectorToWorldSpace(h)
	end
	local move = hum.MoveDirection
	local fwd = 0
	if move.Magnitude > 0.1 then
		local right = h:Cross(Vector3.yAxis)
		local steer = move:Dot(right)
		fwd = move:Dot(h)
		h = CFrame.Angles(0, -steer * 1.4 * dt, 0):VectorToWorldSpace(h)
	end
	h = Vector3.new(h.X, 0, h.Z).Unit
	st.heading = h

	-- inclinação lateral conforme a curva
	local turned = math.atan2(before:Cross(h).Y, before:Dot(h)) / math.max(dt, 1 / 240)
	local bankT = clamp(math.deg(turned) * 0.35, -32, 32)
	st.bank = lerp(st.bank, bankT, 1 - math.exp(-6 * dt))
	local leanT = clamp(52 - cl.Y * 28, 34, 74)
	st.lean = lerp(st.lean, leanT, 1 - math.exp(-3 * dt))

	-- velocidade: olhar para baixo mergulha, para cima segura a queda
	local tgtSpeed = clamp(52 + (-cl.Y) * 34 + fwd * 12, 34, 92)
	local tgtVy = -clamp(13 - cl.Y * 45, 5, 52)
	st.speed = lerp(st.speed, tgtSpeed, 1 - math.exp(-2 * dt))
	st.vy = lerp(st.vy, tgtVy, 1 - math.exp(-2.5 * dt))
	Glide.lv.VectorVelocity = h * st.speed + Vector3.new(0, st.vy, 0)

	local pos = hrp.Position
	hrp.CFrame = CFrame.lookAt(pos, pos + h)

	if os.clock() >= st.entry then
		local m = Rig.joints.RJ
		if m and m.Parent and Rig.orig[m] then
			m.C0 = offsetC0(Rig.orig[m], RZ(st.bank) * RX(-st.lean))
		end
	end

	local elapsed = os.clock() - st.t0
	if elapsed > 0.45 then
		-- pouso
		local res = Workspace:Raycast(pos, Vector3.new(0, -5, 0), Glide.params)
		if res then Glide.stop() return end
		-- parede
		local moved = Vector3.new(pos.X - st.last.X, 0, pos.Z - st.last.Z).Magnitude / math.max(dt, 1 / 120)
		if moved < st.speed * 0.2 then st.stall = st.stall + dt else st.stall = 0 end
		if st.stall > 0.5 then Glide.stop() return end
	end
	st.last = pos
end

function Glide.start()
	if State.glide or not State.cape or not Rig.alive then return end
	local hrp, hum = Rig.hrp, Rig.hum
	if hum.Health <= 0 then return end
	Anim.begin()
	Tools.hide()
	Tools.hideDetonator()
	State.tool = nil
	State.glide = true
	State.glideStart = os.clock()

	local look = hrp.CFrame.LookVector
	local heading = Vector3.new(look.X, 0, look.Z)
	heading = heading.Magnitude > 0.01 and heading.Unit or Vector3.new(0, 0, -1)
	local vel0 = hrp.AssemblyLinearVelocity
	if hum.FloorMaterial ~= Enum.Material.Air then
		vel0 = Vector3.new(vel0.X, 44, vel0.Z)
		hrp.AssemblyLinearVelocity = vel0
		hum:ChangeState(Enum.HumanoidStateType.Jumping)
	end

	local att = create("Attachment", { Name = "BTS_GlideAtt" }, hrp)
	local lv = create("LinearVelocity", {
		Name = "BTS_Glide", Attachment0 = att, RelativeTo = Enum.ActuatorRelativeTo.World,
		MaxForce = 1e7, VectorVelocity = vel0,
	}, hrp)
	Glide.att, Glide.lv = att, lv
	Glide.old = { auto = hum.AutoRotate, ps = hum.PlatformStand }
	Glide.params = rayParams()
	hum.AutoRotate = false
	hum.PlatformStand = true

	-- abre a capa e estende os braços
	Anim.pose({
		RS = RZ(86) * RX(-10), LS = RZ(-86) * RX(-10),
		RE = RX(6), LE = RX(6), NK = RX(34), RJ = RX(-52),
	}, 0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	if Cape.open then tw(Cape.open, 0.4, { Value = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out) end

	local st = {
		heading = heading,
		speed = math.max(40, Vector3.new(vel0.X, 0, vel0.Z).Magnitude),
		vy = vel0.Y, bank = 0, lean = 52, t0 = os.clock(), entry = os.clock() + 0.34,
		stall = 0, last = hrp.Position,
	}
	Glide.conn = RunService.Heartbeat:Connect(function(dt) Glide.step(dt, st) end)
	refreshUI()
end

