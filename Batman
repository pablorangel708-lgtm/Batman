local function selectTool(name)
	if not Rig.alive then toast("Aguardando o personagem…") return end
	if State.glide then Glide.stop() end
	local prev = State.tool
	if prev == name then name = nil end
	local hadModel = Tools.model ~= nil
	local token = Anim.begin() -- cancela qualquer animação em andamento
	State.tool = name
	State.busy = true
	refreshUI()
	task.spawn(function()
		local ok, err = pcall(function()
			Tools.hideDetonator()
			if hadModel and prev then
				if not Anim.step(token, BELT[prev], 0.14) then return end
			end
			Tools.hide()
			if name then
				if not Anim.step(token, BELT[name], 0.15) then return end
				Tools.show(name)
				playSound(CONFIG.Sounds.Draw, 0.5)
				Anim.step(token, HOLD[name], 0.22)
			else
				Anim.step(token, {}, 0.2)
			end
		end)
		if not ok then warn("[BatmanTacticalSystem] " .. tostring(err)) end
		if token == Anim.token then State.busy = false end
	end)
end

local function setCape(on)
	if on == State.cape then return end
	State.cape = on
	if on then
		if Rig.alive then
			Cape.build()
			if not State.tool and not State.busy and not State.glide then
				runJob(function(token)
					-- capa se abre e assenta
					if Cape.open then tw(Cape.open, 0.28, { Value = 0.55 }) end
					if not Anim.step(token, { RS = RX(110) * RZ(-10), LS = RX(110) * RZ(10), RE = RX(30), LE = RX(30), NK = RX(-8) }, 0.18) then return end
					if Cape.open then tw(Cape.open, 0.3, { Value = 0.4 }) end
					if not Anim.step(token, { RS = RZ(70) * RX(-15), LS = RZ(-70) * RX(-15), RE = RX(8), LE = RX(8) }, 0.18) then return end
					if Cape.open then tw(Cape.open, 0.45, { Value = 0 }) end
					Anim.step(token, {}, 0.25)
				end)
			end
		end
	else
		if State.glide then Glide.stop() end
		Cape.destroy(false)
	end
	refreshUI()
end

local function setGPS(on)
	State.gps = on
	if GPS.ui then
		GPS.ui.frame.Visible = on
		if on then GPS.update() end
	end
	refreshUI()
end

local function setNV(on)
	State.nv = on
	if on then NV.enable() else NV.disable() end
	refreshUI()
end

local function primaryAction()
	if State.tool == "hook" then fireHook()
	elseif State.tool == "batarang" then throwBatarang()
	elseif State.tool == "gel" then applyGel()
	elseif State.cape then
		if State.glide then Glide.stop() else Glide.start() end
	end
end

local function secondaryAction()
	if State.tool == "gel" and #Gel.list > 0 then
		detonateGel()
	elseif State.cape and State.tool then
		Glide.start()
	end
end

