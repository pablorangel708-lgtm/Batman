function Cape.destroy(immediate)
	pcall(function() RunService:UnbindFromRenderStep("BTS_Cape") end)
	local folder = Cape.folder
	Cape.parts, Cape.folder, Cape.clasp = nil, nil, nil
	if folder then
		if immediate then
			pcall(function() folder:Destroy() end)
		else
			for _, d in ipairs(folder:GetChildren()) do
				if d:IsA("BasePart") then tw(d, 0.25, { Transparency = 1 }) end
			end
			Debris:AddItem(folder, 0.4)
		end
	end
	Cape.open = nil
end

function Cape.step(dt)
	local parts = Cape.parts
	local torso, hrp = Rig.torso, Rig.hrp
	if not parts or not Cape.open or not torso or not torso.Parent or not hrp then return end
	dt = math.min(dt, 1 / 30)
	local openV = Cape.open.Value
	local tcf = torso.CFrame
	local vel = hrp.AssemblyLinearVelocity
	local spd = vel.Magnitude
	local g = tcf:VectorToObjectSpace(Vector3.new(0, -1, 0))
	local wind = Vector3.zero
	if spd > 0.5 then wind = tcf:VectorToObjectSpace(-vel / spd) end
	local k = clamp(spd / 40, 0, 1) * 1.6
	local d = g + wind * k
	local s = clamp(math.atan2(d.Z, -d.Y), -0.3, 1.75)
	local now = os.clock()
	local flutter = 0.025 + clamp(spd / 80, 0, 1) * 0.07 + openV * 0.04
	local size = torso.Size
	local P = Vector3.new(0, size.Y / 2 - 0.12, size.Z / 2 + 0.07)
	local segLen = CAPE_SEG * (1 + openV * 0.35)
	for i = 1, CAPE_ROWS do
		local frac = (i - 1) / (CAPE_ROWS - 1)
		local target = s * (0.18 + 0.82 * frac) + 0.06 * frac + math.sin(now * (8 + i * 1.4) + i * 0.9) * flutter * (0.4 + frac)
		local K = 70 - i * 6
		local w = Cape.omega[i] + ((target - Cape.theta[i]) * K - Cape.omega[i] * 9) * dt
		Cape.omega[i] = w
		Cape.theta[i] = Cape.theta[i] + w * dt
		local th = Cape.theta[i]
		local dir = Vector3.new(0, -math.cos(th), math.sin(th))
		local center = P + dir * (segLen / 2)
		local width = lerp(IDLE_W[i], WING_W[i], openV)
		local yaw = math.sin(now * 5 + i) * 0.04 * (0.3 + flutter * 5)
		parts[i].Size = Vector3.new(width, segLen + 0.03, 0.1)
		parts[i].CFrame = tcf * CFrame.new(center) * CFrame.Angles(-th, yaw, 0)
		P = P + dir * segLen
	end
	if Cape.clasp then
		Cape.clasp.CFrame = tcf * CFrame.new(0, size.Y / 2 - 0.08, -(size.Z / 2 + 0.06))
	end
end

function Cape.build()
	Cape.destroy(true)
	local torso = Rig.torso
	if not (Rig.alive and torso) then return end
	local folder = create("Folder", { Name = "BTS_Cape" }, Rig.char)
	Cape.folder = folder
	Cape.open = create("NumberValue", { Name = "Open", Value = 0 }, folder)
	Cape.parts = {}
	for i = 1, CAPE_ROWS do
		local p = newPart({
			Name = "Row" .. i, Anchored = true, Material = Enum.Material.Fabric,
			Color = (i % 2 == 0) and Color3.fromRGB(21, 21, 26) or Color3.fromRGB(11, 11, 14),
			Size = Vector3.new(IDLE_W[i], CAPE_SEG, 0.1), Transparency = 1,
		})
		p.Parent = folder
		Cape.parts[i] = p
		Cape.theta[i] = 0.1
		Cape.omega[i] = 0
		tw(p, 0.35, { Transparency = 0 })
	end
	Cape.clasp = newPart({ Name = "Clasp", Anchored = true, Size = Vector3.new(0.45, 0.2, 0.12), Color = C.YEL, Material = Enum.Material.Metal, Transparency = 1 })
	Cape.clasp.Parent = folder
	tw(Cape.clasp, 0.35, { Transparency = 0 })
	RunService:BindToRenderStep("BTS_Cape", Enum.RenderPriority.Character.Value + 1, Cape.step)
end

