local function launchBatarang(pos, dir)
	local model, body = Models.batarang()
	body.Anchored = true
	model.Parent = worldFx
	model:PivotTo(CFrame.new(pos))
	local a0 = create("Attachment", { Position = Vector3.new(-1.2, 0, 0) }, body)
	local a1 = create("Attachment", { Position = Vector3.new(1.2, 0, 0) }, body)
	create("Trail", {
		Attachment0 = a0, Attachment1 = a1, Lifetime = 0.22, LightEmission = 0.5, MinLength = 0.05,
		Color = ColorSequence.new(C.YEL),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) }),
	}, body)
	local params = rayParams()
	local traveled, spin = 0, 0
	local conn
	conn = RunService.Heartbeat:Connect(function(dt)
		local step = CONFIG.BatarangSpeed * dt
		local res = Workspace:Raycast(pos, dir * (step + 0.4), params)
		spin = spin + dt * 28
		if res then
			conn:Disconnect()
			local p = res.Position + res.Normal * 0.05
			model:PivotTo(CFrame.lookAt(p, p + res.Normal) * RX(-90) * RY(math.random(0, 359)))
			sparks(res.Position, Color3.fromRGB(255, 220, 90), 10)
			playSound(CONFIG.Sounds.Hit, 0.6, 1.1)
			Debris:AddItem(model, 6)
			return
		end
		pos = pos + dir * step
		traveled = traveled + step
		model:PivotTo(CFrame.new(pos) * CFrame.Angles(0, spin, 0))
		if traveled > CONFIG.BatarangRange then
			conn:Disconnect()
			model:Destroy()
		end
	end)
	Debris:AddItem(model, 8)
end

local function throwBatarang()
	if State.tool ~= "batarang" or State.busy or State.glide or not Rig.alive then return end
	if os.clock() < State.cd.batarang then return end
	State.cd.batarang = os.clock() + CONFIG.BatarangCooldown
	flashAction(CONFIG.BatarangCooldown)
	local res, camDir, endPoint = aimInfo(CONFIG.BatarangRange)
	runJob(function(token)
		if not turnToward(token, camDir, 0.1) then return end
		local pitch = math.deg(math.asin(clamp(camDir.Y, -1, 1)))
		local a = clamp(90 + pitch, 20, 170)
		-- preparação
		if not Anim.step(token, { RS = RX(-55) * RZ(-8), RE = RX(85), LS = RX(20) * RZ(12), LE = RX(30), WA = RY(-34), NK = RY(-10) }, 0.16) then return end
		-- arremesso (braço estende)
		Anim.pose({ RS = RX(a) * RZ(-4), RE = RX(8), LS = RX(-15) * RZ(-32), LE = RX(18), WA = RY(26), NK = RY(10) }, 0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		task.wait(0.07)
		if token ~= Anim.token then return end
		local startPos = handFront()
		local aimTarget = res and res.Position or endPoint
		local d = aimTarget - startPos
		local dir = d.Magnitude > 1 and d.Unit or camDir
		Tools.hide()
		launchBatarang(startPos, dir)
		playSound(CONFIG.Sounds.Throw, 0.7, 1.4)
		task.wait(0.06)
		-- acompanhamento e retorno
		if not Anim.step(token, { RS = RX(a + 14), RE = RX(2), LS = RX(-20) * RZ(-34), LE = RX(14), WA = RY(32), NK = RY(12) }, 0.1) then return end
		if not Anim.step(token, BELT.batarang, 0.16) then return end
		Tools.show("batarang")
		playSound(CONFIG.Sounds.Draw, 0.4, 1.3)
		Anim.step(token, HOLD.batarang, 0.2)
	end)
end

