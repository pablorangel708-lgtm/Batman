		Speed = NumberRange.new(14, 32),
		SpreadAngle = Vector2.new(180, 180),
		Acceleration = Vector3.new(0, -50, 0),
		Color = ColorSequence.new(color),
		LightEmission = 1,
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.28), NumberSequenceKeypoint.new(1, 0) }),
	}, p)
	e:Emit(count)
	Debris:AddItem(p, 1.5)
end

local function shake(mag, dur)
	local hum = Rig.hum
	if not hum then return end
	task.spawn(function()
		local t0 = os.clock()
		while hum.Parent do
			local a = (os.clock() - t0) / dur
			if a >= 1 then break end
			local m = mag * (1 - a)
			hum.CameraOffset = Vector3.new((math.random() - 0.5) * m, (math.random() - 0.5) * m, 0)
			RunService.RenderStepped:Wait()
		end
		if hum.Parent then hum.CameraOffset = Vector3.zero end
	end)
end

local function boom(pos, fromRemote)
	-- Somente efeito visual local: sem dano, sem alterar o mapa.
	local orange = Color3.fromRGB(255, 150, 30)
	local core = newPart({ Shape = Enum.PartType.Ball, Anchored = true, Size = Vector3.new(1, 1, 1), Position = pos, Color = Color3.fromRGB(255, 235, 140), Material = Enum.Material.Neon, Transparency = 0.05, Parent = worldFx })
	tw(core, 0.4, { Size = Vector3.new(9, 9, 9), Transparency = 1 })
	local fire = newPart({ Shape = Enum.PartType.Ball, Anchored = true, Size = Vector3.new(1, 1, 1), Position = pos, Color = orange, Material = Enum.Material.Neon, Transparency = 0.3, Parent = worldFx })
	tw(fire, 0.6, { Size = Vector3.new(16, 16, 16), Transparency = 1 })
	local ring = newPart({ Shape = Enum.PartType.Cylinder, Anchored = true, Size = Vector3.new(0.4, 1, 1), CFrame = CFrame.new(pos) * RZ(90), Color = Color3.fromRGB(255, 200, 80), Material = Enum.Material.Neon, Transparency = 0.35, Parent = worldFx })
	tw(ring, 0.55, { Size = Vector3.new(0.4, 26, 26), Transparency = 1 })
	Debris:AddItem(core, 1)
	Debris:AddItem(fire, 1)
	Debris:AddItem(ring, 1)

	local anchor = newPart({ Anchored = true, Transparency = 1, Size = Vector3.new(0.5, 0.5, 0.5), Position = pos, Parent = worldFx })
	local light = create("PointLight", { Brightness = 10, Range = 28, Color = Color3.fromRGB(255, 170, 60) }, anchor)
	tw(light, 0.6, { Brightness = 0 })
	local em = create("ParticleEmitter", {
		Rate = 0, Lifetime = NumberRange.new(0.5, 1.1), Speed = NumberRange.new(25, 55),
		SpreadAngle = Vector2.new(180, 180), Acceleration = Vector3.new(0, -35, 0),
		Color = ColorSequence.new(orange), LightEmission = 1,
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) }),
	}, anchor)
	em:Emit(45)
	local smoke = create("ParticleEmitter", {
		Rate = 0, Lifetime = NumberRange.new(1.4, 2.4), Speed = NumberRange.new(6, 16),
		SpreadAngle = Vector2.new(180, 180), Color = ColorSequence.new(Color3.fromRGB(45, 45, 48)),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2), NumberSequenceKeypoint.new(1, 9) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) }),
	}, anchor)
	smoke:Emit(16)
	Debris:AddItem(anchor, 3)

	playSound(CONFIG.Sounds.Boom, fromRemote and 0.8 or 1.6, 0.7)
	local dist = Rig.hrp and (Rig.hrp.Position - pos).Magnitude or 999
	local mag = clamp(1.4 * (1 - dist / 70), 0, 1.4)
	if mag > 0.05 then shake(fromRemote and mag * 0.6 or mag, 0.45) end
end

