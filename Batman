local function fireHook()
	if State.tool ~= "hook" or State.busy or State.glide or not Rig.alive then return end
	if os.clock() < State.cd.hook then toast("Gancho recarregando…") return end
	local res = aimInfo(CONFIG.HookRange)
	if not res or (res.Position - Rig.hrp.Position).Magnitude > CONFIG.HookRange then
		toast("Sem ponto de ancoragem ao alcance")
		return
	end
	State.cd.hook = os.clock() + CONFIG.HookCooldown
	flashAction(CONFIG.HookCooldown)
	local target = res.Position
	runJob(function(token)
		local hrp = Rig.hrp
		if not turnToward(token, target - hrp.Position, 0.12) then return end
		local dirT = (target - muzzlePos()).Unit
		local pitch = math.deg(math.asin(clamp(dirT.Y, -1, 1)))
		local aimA = clamp(90 + pitch, 15, 175)
		local aimPose = { RS = RX(aimA), RE = RX(6), LS = RX(aimA - 12) * RZ(28), LE = RX(38), WA = RY(-8) }
		if not Anim.step(token, aimPose, 0.14) then return end

		Cable.show(muzzlePos)
		playSound(CONFIG.Sounds.Fire, 0.7, 1.2)
		if not Anim.step(token, { RS = RX(aimA + 9), RE = RX(4), LS = RX(aimA - 12) * RZ(28), LE = RX(38), WA = RY(-4) }, 0.05, Enum.EasingStyle.Quad, Enum.EasingDirection.Out) then return end
		Anim.pose(aimPose, 0.12)

		local startPt = muzzlePos()
		local dur = math.max((target - startPt).Magnitude / 230, 0.08)
		local t0 = os.clock()
		while token == Anim.token do
			local a = math.min((os.clock() - t0) / dur, 1)
			Cable.endPos = startPt:Lerp(target, a)
			if a >= 1 then break end
			RunService.Heartbeat:Wait()
		end
		if token ~= Anim.token then return end
		sparks(target, Color3.fromRGB(255, 210, 60), 14)
		playSound(CONFIG.Sounds.Hit, 0.6, 1.3)

		Anim.pose({ RS = RX(clamp(aimA + 18, 0, 178)), RE = RX(10), LS = RX(-18) * RZ(-30), LE = RX(12), WA = RX(-14), NK = RX(8) }, 0.15)
		pullPlayer(token, target)
		if token ~= Anim.token then return end

		-- recolhe o cabo
		local r0 = os.clock()
		while token == Anim.token do
			local a = math.min((os.clock() - r0) / 0.15, 1)
			Cable.endPos = muzzlePos():Lerp(target, 1 - a)
			if a >= 1 then break end
			RunService.Heartbeat:Wait()
		end
		Cable.hide()
		Anim.step(token, HOLD.hook, 0.25)
	end)
end

