local function teardownCharacter()
	Glide.stop(true)
	Anim.cancel()
	Tools.hide()
	Tools.hideDetonator()
	Cable.hide()
	Gel.clear()
	Cape.destroy(true)
	if Rig.alive then Anim.hardReset() end
	Rig.alive = false
	State.tool = nil
	State.busy = false
	State.glide = false
	refreshUI()
end

local function setupCharacter(char)
	teardownCharacter()
	local hum = char:WaitForChild("Humanoid", 10)
	local hrp = char:WaitForChild("HumanoidRootPart", 10)
	if not hum or not hrp then return end
	local t0 = os.clock()
	local ok = false
	repeat
		ok = indexRig(char)
		if ok then break end
		task.wait(0.1)
	until os.clock() - t0 > 6
	if not ok then
		toast("Rig incompatível com o sistema")
		return
	end
	Rig.char, Rig.hum, Rig.hrp = char, hum, hrp
	Rig.r15 = hum.RigType == Enum.HumanoidRigType.R15
	Rig.torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
	Rig.rHand = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
	Rig.lHand = char:FindFirstChild("LeftHand") or char:FindFirstChild("Left Arm")
	Rig.alive = true
	State.airStart = 0

	hum.Died:Connect(function()
		if Rig.char == char then teardownCharacter() end
	end)
	char.AncestryChanged:Connect(function(_, parent)
		if not parent and Rig.char == char then teardownCharacter() end
	end)
	hum.StateChanged:Connect(function(_, new)
		if new == Enum.HumanoidStateType.Freefall or new == Enum.HumanoidStateType.Jumping then
			if os.clock() - State.airStart > 0.3 or State.airStart == 0 then State.airStart = os.clock() end
		end
	end)

	if State.cape then Cape.build() end
	refreshUI()
end

player.CharacterAdded:Connect(function(char) task.spawn(setupCharacter, char) end)
if player.Character then task.spawn(setupCharacter, player.Character) end

