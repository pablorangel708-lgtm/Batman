	rHand = nil, lHand = nil, joints = {}, orig = {}, r15 = false,
}

local JOINT_NAMES = {
	RS = { "RightShoulder", "Right Shoulder" },
	LS = { "LeftShoulder", "Left Shoulder" },
	RE = { "RightElbow" },
	LE = { "LeftElbow" },
	WA = { "Waist" },
	NK = { "Neck" },
	RJ = { "RootJoint" },
}

local function offsetC0(orig, off)
	-- gira em torno do pivô da articulação, nos eixos do Part0 (funciona em R6 e R15)
	return CFrame.new(orig.Position) * off * orig.Rotation
end

local function indexRig(char)
	local joints, orig = {}, {}
	for key, names in pairs(JOINT_NAMES) do
		for _, n in ipairs(names) do
			local m = char:FindFirstChild(n, true)
			if m and m:IsA("Motor6D") then
				joints[key] = m
				orig[m] = m.C0
				break
			end
		end
	end
	if not joints.WA and joints.RJ then joints.WA = joints.RJ end -- R6: cintura = raiz
	Rig.joints, Rig.orig = joints, orig
	return joints.RS ~= nil and joints.LS ~= nil and joints.RJ ~= nil
end

local function rayParams()
	local p = RaycastParams.new()
	p.FilterType = Enum.RaycastFilterType.Exclude
	local list = { worldFx }
	if Rig.char then table.insert(list, Rig.char) end
	p.FilterDescendantsInstances = list
	p.IgnoreWater = true
	return p
end

------------------------------------------------------------------------
-- MOTOR DE ANIMAÇÃO PROCEDURAL
------------------------------------------------------------------------
local Anim = { token = 0, tweens = {}, cleanups = {} }

function Anim.cancel()
	Anim.token = Anim.token + 1
	for _, t in ipairs(Anim.tweens) do
		pcall(function() t:Cancel() end)
	end
	table.clear(Anim.tweens)
	local list = Anim.cleanups
	Anim.cleanups = {}
	for _, f in ipairs(list) do pcall(f) end
	State.busy = false
end

function Anim.begin()
	Anim.cancel()
	return Anim.token
end

function Anim.addCleanup(f)
	table.insert(Anim.cleanups, f)
end

-- Pose COMPLETA: qualquer articulação não citada volta à posição original.
function Anim.pose(pose, dur, style, dir)
	local offs = {}
	for key, off in pairs(pose) do
		local m = Rig.joints[key]
		if m then
			offs[m] = offs[m] and (offs[m] * off) or off
		end
	end
	local seen = {}
	for _, m in pairs(Rig.joints) do
		if not seen[m] and m.Parent and Rig.orig[m] then
			seen[m] = true
			local goal = offsetC0(Rig.orig[m], offs[m] or ID)
			if dur and dur > 0 then
				local t = TweenService:Create(m, TweenInfo.new(dur, style or Enum.EasingStyle.Sine, dir or Enum.EasingDirection.InOut), { C0 = goal })
				table.insert(Anim.tweens, t)
				t:Play()
			else
				m.C0 = goal
			end
		end
	end
end

function Anim.step(token, pose, dur, style, dir)
	if token ~= Anim.token then return false end
	Anim.pose(pose, dur, style, dir)
	if dur and dur > 0 then task.wait(dur) end
	return token == Anim.token
end

function Anim.hardReset()
	for _, m in pairs(Rig.joints) do
		pcall(function()
			if Rig.orig[m] then m.C0 = Rig.orig[m] end
		end)
	end
end

local function runJob(fn)
	if State.busy or not Rig.alive then return end
	local token = Anim.begin()
	State.busy = true
	task.spawn(function()
		local ok, err = pcall(fn, token)
		if not ok then warn("[BatmanTacticalSystem] " .. tostring(err)) end
		if token == Anim.token then State.busy = false end
	end)
end

