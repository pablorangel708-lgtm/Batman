local function sparks(pos, color, count)
	local p = newPart({ Anchored = true, Transparency = 1, Size = Vector3.new(0.2, 0.2, 0.2), Position = pos, Parent = worldFx })
	local e = create("ParticleEmitter", {
		Rate = 0,
