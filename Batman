local function makeDraggable(handle, target, onTap)
	local dragging, active, startIn, startPos, moved = false, nil, Vector3.zero, Vector2.zero, false
	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging, active, moved = true, input, false
			startIn = input.Position
			startPos = target.AbsolutePosition
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					if dragging and active == input and not moved and onTap then onTap() end
					if active == input then dragging = false end
				end
			end)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if not dragging or not active then return end
		local isMouse = input.UserInputType == Enum.UserInputType.MouseMovement and active.UserInputType == Enum.UserInputType.MouseButton1
		if isMouse or input == active then
			local d = input.Position - startIn
			if d.Magnitude > 8 then moved = true end
			if moved then
				local sz = gui.AbsoluteSize
				local w, h = target.AbsoluteSize.X, target.AbsoluteSize.Y
				local x = clamp(startPos.X + d.X, 0, math.max(sz.X - w, 0))
				local y = clamp(startPos.Y + d.Y, 0, math.max(sz.Y - h, 0))
				target.Position = UDim2.fromOffset(x, y)
			end
		end
	end)
end

