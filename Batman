-- atualização geral da interface
refreshUI = function()
	local names = {}
	for _, e in ipairs(EQUIP) do
		local b = equipButtons[e.id]
		local on = isActive(e.id)
		b.led.BackgroundColor3 = on and C.YEL or C.OFF
		tw(b.btn, 0.15, { BackgroundColor3 = on and C.ON_BG or C.MID })
		b.stroke.Color = on and C.YEL or C.LINE
		if on then table.insert(names, e.name) end
	end
	if State.glide then table.insert(names, "PLANANDO") end
	statusLbl.Text = (#names > 0) and ("ATIVO: " .. table.concat(names, "  •  ")) or "Nenhum equipamento ativo"

	-- botão principal
	local show = State.tool ~= nil or State.cape
	actBtn.Visible = show
	if State.tool == "hook" then actIcon.Text, actLbl.Text = "⚓", "GANCHO"
	elseif State.tool == "batarang" then actIcon.Text, actLbl.Text = "🦇", "LANÇAR"
	elseif State.tool == "gel" then actIcon.Text, actLbl.Text = "💥", "APLICAR"
	elseif State.glide then actIcon.Text, actLbl.Text = "🧣", "SOLTAR"
	else actIcon.Text, actLbl.Text = "🧣", "PLANAR" end

	-- botão secundário
	if State.tool == "gel" and #Gel.list > 0 then
		act2Btn.Visible = true
		act2Icon.Text, act2Lbl.Text = "🔴", "DETONAR"
	elseif State.cape and State.tool then
		act2Btn.Visible = true
		act2Icon.Text, act2Lbl.Text = "🧣", "PLANAR"
	else
		act2Btn.Visible = false
	end
	crosshair.Visible = State.tool ~= nil
end

