local function clamp(x, a, b) return math.max(a, math.min(b, x)) end
local function lerp(a, b, t) return a + (b - a) * t end
local function RX(d) return CFrame.Angles(math.rad(d), 0, 0) end
local function RY(d) return CFrame.Angles(0, math.rad(d), 0) end
local function RZ(d) return CFrame.Angles(0, 0, math.rad(d)) end
local ID = CFrame.new()

local function create(class, props, parent)
	local inst = Instance.new(class)
	if props then
		for k, v in pairs(props) do inst[k] = v end
	end
	if parent then inst.Parent = parent end
	return inst
end

local function newPart(props, class)
	local p = Instance.new(class or "Part")
	p.Anchored = false
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	p.Color = C.DARK
	if props then
		for k, v in pairs(props) do p[k] = v end
	end
	return p
end

local function tw(inst, t, props, style, dir)
	local tween = TweenService:Create(inst, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tween:Play()
	return tween
end

local function playSound(id, vol, speed)
	if not id or id == "" then return end
	pcall(function()
		local s = Instance.new("Sound")
		s.SoundId = id
		s.Volume = vol or 0.7
		s.PlaybackSpeed = speed or 1
		s.Parent = SoundService
		s:Play()
		Debris:AddItem(s, 4)
	end)
end

