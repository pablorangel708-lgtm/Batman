local NV = { original = nil, cc = nil, bloom = nil, overlay = nil }

function NV.enable()
	if not NV.original then
		NV.original = {
			Ambient = Lighting.Ambient,
			OutdoorAmbient = Lighting.OutdoorAmbient,
			Brightness = Lighting.Brightness,
			ExposureCompensation = Lighting.ExposureCompensation,
		}
	end
	if not NV.cc or not NV.cc.Parent then
		NV.cc = create("ColorCorrectionEffect", { Name = "BTS_NV_CC", TintColor = Color3.new(1, 1, 1), Saturation = 0, Contrast = 0, Brightness = 0 }, Lighting)
	end
	if not NV.bloom or not NV.bloom.Parent then
		NV.bloom = create("BloomEffect", { Name = "BTS_NV_Bloom", Intensity = 0, Size = 24, Threshold = 0.9 }, Lighting)
	end
	local o = NV.original
	tw(Lighting, 0.5, {
		Ambient = Color3.fromRGB(80, 130, 85), OutdoorAmbient = Color3.fromRGB(80, 130, 85),
		Brightness = o.Brightness + 0.5, ExposureCompensation = o.ExposureCompensation + 0.7,
	})
	tw(NV.cc, 0.5, { TintColor = Color3.fromRGB(170, 255, 185), Saturation = -0.25, Contrast = 0.12, Brightness = 0.06 })
	tw(NV.bloom, 0.5, { Intensity = 0.5 })
	if NV.overlay then NV.overlay.Visible = true end
	playSound(CONFIG.Sounds.Click, 0.5, 0.8)
end

function NV.disable()
	local o = NV.original
	if not o then return end
	tw(Lighting, 0.4, { Ambient = o.Ambient, OutdoorAmbient = o.OutdoorAmbient, Brightness = o.Brightness, ExposureCompensation = o.ExposureCompensation })
	if NV.cc then tw(NV.cc, 0.4, { TintColor = Color3.new(1, 1, 1), Saturation = 0, Contrast = 0, Brightness = 0 }) end
	if NV.bloom then tw(NV.bloom, 0.4, { Intensity = 0 }) end
	if NV.overlay then NV.overlay.Visible = false end
	task.delay(0.5, function()
		if State.nv then return end -- religou antes do fim
		local orig = NV.original
		if orig then
			Lighting.Ambient = orig.Ambient
			Lighting.OutdoorAmbient = orig.OutdoorAmbient
			Lighting.Brightness = orig.Brightness
			Lighting.ExposureCompensation = orig.ExposureCompensation
		end
		if NV.cc then NV.cc:Destroy() NV.cc = nil end
		if NV.bloom then NV.bloom:Destroy() NV.bloom = nil end
		NV.original = nil
	end)
end

------------------------------------------------------------------------
-- GPS (usa apenas personagens que o cliente já enxerga)
------------------------------------------------------------------------
local GPS = { ui = nil, accum = 0 }

function GPS.update()
	local ui = GPS.ui
	if not ui or not State.gps then return end
	local hrp = Rig.hrp
	local cam = Workspace.CurrentCamera
	local cl = cam.CFrame.LookVector
	local f = Vector3.new(cl.X, 0, cl.Z)
	f = f.Magnitude > 0.01 and f.Unit or Vector3.new(0, 0, -1)
	local r = f:Cross(Vector3.yAxis)
	if hrp then
		ui.coords.Text = string.format("X %d  Y %d  Z %d", hrp.Position.X, hrp.Position.Y, hrp.Position.Z)
	end
	ui.heading.Text = string.format("Rumo %03d°", (math.deg(math.atan2(f.X, -f.Z)) + 360) % 360)

	local list = {}
	if hrp then
		for _, pl in ipairs(Players:GetPlayers()) do
			if pl ~= player then
				local ch = pl.Character
				local root = ch and ch:FindFirstChild("HumanoidRootPart")
				if root then
					local off = root.Position - hrp.Position
					table.insert(list, { name = pl.DisplayName, off = off, dist = off.Magnitude })
				end
			end
		end
	end
	table.sort(list, function(a, b) return a.dist < b.dist end)

	local radius = ui.radarSize / 2 - 6
	for i, dot in ipairs(ui.dots) do
		local e = list[i]
		if e then
			local sc = radius / CONFIG.GpsRange
			local x, y = e.off:Dot(r) * sc, -e.off:Dot(f) * sc
			local m = math.sqrt(x * x + y * y)
			local out = m > radius
			if out then x, y = x / m * radius, y / m * radius end
			dot.Position = UDim2.new(0.5, x - 4, 0.5, y - 4)
			dot.BackgroundColor3 = (i == 1) and C.YEL or C.LIT
			dot.BackgroundTransparency = out and 0.6 or 0
			dot.Visible = true
		else
			dot.Visible = false
		end
	end
	local lines = {}
	for i = 1, math.min(3, #list) do
		lines[i] = string.format("%s — %d st", list[i].name, list[i].dist)
	end
	ui.list.Text = (#lines > 0) and table.concat(lines, "\n") or "Nenhum jogador visível"
end

RunService.Heartbeat:Connect(function(dt)
	if not State.gps then return end
	GPS.accum = GPS.accum + dt
	if GPS.accum >= 0.12 then
		GPS.accum = 0
		GPS.update()
	end
end)

