toast = function(msg)
	toastToken = toastToken + 1
	local my = toastToken
	toastLabel.Text = msg
	toastLabel.Visible = true
	toastLabel.TextTransparency = 1
	toastLabel.BackgroundTransparency = 1
	tw(toastLabel, 0.15, { TextTransparency = 0, BackgroundTransparency = 0.15 })
	task.delay(1.8, function()
		if my == toastToken then
			tw(toastLabel, 0.3, { TextTransparency = 1, BackgroundTransparency = 1 })
		end
	end)
end

