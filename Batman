local Cable = { part = nil, hook = nil, conn = nil, startFn = nil, endPos = Vector3.zero }

function Cable.hide()
	if Cable.conn then Cable.conn:Disconnect() Cable.conn = nil end
	if Cable.part then pcall(function() Cable.part:Destroy() end) end
	if Cable.hook then pcall(function() Cable.hook:Destroy() end) end
	Cable.part, Cable.hook = nil, nil
end

function Cable.update()
	if not Cable.part then return end
	local s = Cable.startFn()
	local e = Cable.endPos
	local d = e - s
	local len = d.Magnitude
	if len < 0.15 then
		Cable.part.Transparency = 1
		Cable.hook.Transparency = 1
		return
	end
	Cable.part.Transparency = 0
	Cable.hook.Transparency = 0
	Cable.part.Size = Vector3.new(0.09, 0.09, len)
	Cable.part.CFrame = CFrame.lookAt(s, e) * CFrame.new(0, 0, -len / 2)
	Cable.hook.CFrame = CFrame.lookAt(e, e + d.Unit)
end

function Cable.show(startFn)
	Cable.hide()
	Cable.startFn = startFn
	Cable.endPos = startFn()
	Cable.part = newPart({ Name = "BTS_Cable", Anchored = true, Size = Vector3.new(0.09, 0.09, 1), Color = Color3.fromRGB(40, 40, 44), Material = Enum.Material.Metal, Parent = worldFx })
	Cable.hook = newPart({ Name = "BTS_Grapnel", Anchored = true, Size = Vector3.new(0.34, 0.34, 0.7), Color = C.YEL, Material = Enum.Material.Metal, Parent = worldFx })
	Cable.conn = RunService.RenderStepped:Connect(Cable.update)
	Anim.addCleanup(Cable.hide)
end

