------------------------------------------------------------------------
local function findGelSurface()
	local params = rayParams()
	local reach = CONFIG.GelReach
	local hrp = Rig.hrp
	local cam = Workspace.CurrentCamera
	local vs = cam.ViewportSize
	local ray = cam:ViewportPointToRay(vs.X / 2, vs.Y / 2)
	local res = Workspace:Raycast(ray.Origin, ray.Direction * (reach + 25), params)
	if res and (res.Position - hrp.Position).Magnitude <= reach then return res end
	local o = Rig.torso.Position
	local lk = hrp.CFrame.LookVector
	local f = Vector3.new(lk.X, 0, lk.Z)
	if f.Magnitude > 0.01 then
		res = Workspace:Raycast(o, f.Unit * (reach * 0.8), params)
		if res then return res end
	end
	return Workspace:Raycast(o, Vector3.new(0, -6, 0), params)
end

local function applyGel()
	if State.tool ~= "gel" or State.busy or State.glide or not Rig.alive then return end
	if os.clock() < State.cd.gel then return end
	if #Gel.list >= CONFIG.GelMax then toast("Limite de cargas — detone primeiro") return end
	local hit = findGelSurface()
	if not hit then toast("Aproxime-se de uma superfície") return end
	State.cd.gel = os.clock() + CONFIG.GelCooldown
	flashAction(CONFIG.GelCooldown + 1)

	local hitPos, normal = hit.Position, hit.Normal
	runJob(function(token)
		local hrp = Rig.hrp
		if not turnToward(token, hitPos - hrp.Position, 0.14) then return end
		local to = hitPos - (Rig.torso.Position + Vector3.new(0, 0.6, 0))
		local pitch = math.deg(math.asin(clamp(to.Unit.Y, -1, 1)))
		local a = clamp(90 + pitch, 20, 170)

		local entry = { folder = create("Folder", { Name = "BTS_Gel" }, worldFx), pos = hitPos + normal * 0.1, done = false }
		Anim.addCleanup(function()
			if not entry.done then pcall(function() entry.folder:Destroy() end) end
			if Tools.muzzle then
				local sp = Tools.muzzle:FindFirstChild("Spray")
				if sp then sp.Enabled = false end
			end
		end)

		-- inclina o corpo e estende o aplicador
		if not Anim.step(token, { RS = RX(a), RE = RX(14), LS = RX(30) * RZ(-18), LE = RX(40), WA = RX(-22) * RY(-6) }, 0.2) then return end
		playSound(CONFIG.Sounds.Draw, 0.35, 0.8)
		local spray = Tools.muzzle and Tools.muzzle:FindFirstChild("Spray")
		if spray then spray.Enabled = true end

		local up = math.abs(normal.Y) > 0.9 and Vector3.xAxis or Vector3.yAxis
		local t1 = normal:Cross(up).Unit
		local t2 = normal:Cross(t1).Unit
		local sweeps = { -16, 16, -10, 12, 0 }
		for i, yaw in ipairs(sweeps) do
			local pose = { RS = RY(yaw) * RX(a), RE = RX(14), LS = RX(30) * RZ(-18), LE = RX(40), WA = RX(-22) * RY(-6) }
			if not Anim.step(token, pose, 0.17) then return end
			local lateral = (yaw / 16) * 0.9
			for _ = 1, 3 do
				local c = hitPos + normal * 0.06 + t1 * (lateral + (math.random() - 0.5) * 0.7) + t2 * ((math.random() - 0.5) * 1.3)
				makeGelBlob(entry.folder, c, normal, 0.4 + math.random() * 0.65)
			end
		end
		if spray then spray.Enabled = false end

		-- LED de armado
		local ledPos = hitPos + normal * 0.16
		entry.led = newPart({ Shape = Enum.PartType.Ball, Anchored = true, Size = Vector3.new(0.22, 0.22, 0.22), Position = ledPos, Color = Color3.fromRGB(255, 40, 40), Material = Enum.Material.Neon, Parent = entry.folder })
		entry.light = create("PointLight", { Color = Color3.fromRGB(255, 50, 50), Range = 6, Brightness = 2 }, entry.led)
		entry.done = true
		table.insert(Gel.list, entry)
		Gel.startBlink()
		playSound(CONFIG.Sounds.Beep, 0.5, 1.1)
		refreshUI()
		Anim.step(token, HOLD.gel, 0.25)
	end)
end

local GelEvents = nil -- RemoteEvent opcional do servidor

local function detonateGel()
	if State.tool ~= "gel" or State.busy or State.glide or not Rig.alive then return end
	if #Gel.list == 0 then toast("Nenhuma carga aplicada") return end
	runJob(function(token)
		if not Anim.step(token, { RS = RX(50) * RZ(-10), RE = RX(30), LS = RX(34), LE = RX(10), WA = RY(10) }, 0.12) then return end
		Tools.showDetonator()
		if not Anim.step(token, { RS = RX(50) * RZ(-10), RE = RX(30), LS = RX(78) * RZ(24), LE = RX(70), WA = RY(14) }, 0.2) then return end
		if not Anim.step(token, { RS = RX(50) * RZ(-10), RE = RX(30), LS = RX(82) * RZ(24), LE = RX(62), WA = RY(14) }, 0.07) then return end
		playSound(CONFIG.Sounds.Beep, 0.7, 1.6)
		Gel.fast = true
		task.wait(0.3)
		if token ~= Anim.token then Gel.fast = false return end
		local list = Gel.list
		Gel.list = {}
		for _, g in ipairs(list) do
			boom(g.pos, false)
			if GelEvents then pcall(function() GelEvents:FireServer("GelDetonate", g.pos) end) end
			pcall(function() g.folder:Destroy() end)
			task.wait(0.12)
		end
		Gel.fast = false
		if Gel.conn and #Gel.list == 0 then Gel.conn:Disconnect() Gel.conn = nil end
		refreshUI()
		if not Anim.step(token, HOLD.gel, 0.25) then return end
		Tools.hideDetonator()
	end)
end

